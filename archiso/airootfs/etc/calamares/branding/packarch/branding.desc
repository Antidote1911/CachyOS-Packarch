# SPDX-FileCopyrightText: no
# SPDX-License-Identifier: CC0-1.0
#
# Branding of Packarch, made from the "cachyos" branding of
# cachyos-calamares-next (same layout: sidebar at the bottom, no upload
# server). Calamares finds it in /etc/calamares/branding/packarch
# (settings_*.conf: "branding: packarch").
---
componentName:  packarch

welcomeStyleCalamares:   false
welcomeExpandingLogo:   true

windowExpanding:    normal
windowSize: 1100px,520px
windowPlacement: center

sidebar: qml,bottom
navigation: widget

strings:
    productName:         Packarch
    shortProductName:    Packarch
    version:             rolling
    shortVersion:        rolling
    versionedName:       Packarch
    shortVersionedName:  Packarch
    # GRUB_DISTRIBUTOR of the installed system (grubcfg module)
    bootloaderEntryName: Packarch
    productUrl:          https://github.com/Antidote1911/CachyOS-Packarch
    # "Support" button of the welcome page
    supportUrl:          https://github.com/Antidote1911/CachyOS-Packarch/issues

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

# Colors of the logo: dark background, blue of the gradient
style:
   SidebarBackground:        "#1c2027"
   SidebarText:              "#ffffff"
   SidebarTextCurrent:       "#1c2027"
   SidebarBackgroundCurrent: "#62aeef"

slideshow:               "show.qml"
slideshowAPI: 2
