#!/usr/bin/env bash
#
# live-fit-display — bouton « Ajuster la résolution » du tableau de bord du
# live (ajouté par 80-live-xfce-skel.sh ; absent du système installé, qui
# reçoit le /etc/skel de packarch-xfce-settings). Dans une machine virtuelle
# (QEMU, VirtualBox...), la fenêtre propose sa taille comme mode préféré de
# l'écran virtuel, mais XFCE ne l'applique pas tout seul.

output="$(xrandr --query | awk '/ connected/ { print $1; exit }')"
[[ -n "$output" ]] || { echo "Aucun écran connecté" >&2; exit 1; }
exec xrandr --output "$output" --auto
