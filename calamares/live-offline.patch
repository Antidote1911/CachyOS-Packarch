From 05eea591c1082be0a7e5e767ef5dd296eb8d8187 Mon Sep 17 00:00:00 2001
From: build <build@localhost>
Date: Fri, 30 Oct 2026 20:30:00 +0100
Subject: [PATCH] Code changes for the XFCE live ISO (online installation of
 XFCE or Openbox)

The configuration (settings_*.conf and module configurations) is not in
this patch: the ISO ships it in /etc/xdg/calamares, read first with
calamares -X.
---
 src/modules/bootloader/main.py          | 18 +++++++++++++-----
 src/modules/chwd/main.py                |  2 +-
 src/modules/grubcfg/main.py             |  3 +++
 src/modules/netinstall/PackageModel.cpp |  6 ++++++
 src/modules/pacstrap/main.py            |  5 ++---
 src/scripts/shell-setup                 |  3 ++-
 6 files changed, 27 insertions(+), 10 deletions(-)

diff --git a/src/modules/bootloader/main.py b/src/modules/bootloader/main.py
index 4e9095d..a1271f3 100644
--- a/src/modules/bootloader/main.py
+++ b/src/modules/bootloader/main.py
@@ -824,9 +824,14 @@ def update_limine_config(efi_directory, installation_root_path, fw_type):
         except KeyError:
             libcalamares.utils.warning('limineSplashLogo not set. Skipping wallpaper in limine.conf')
 
+        # OS entry named after the branding (Packarch), with its machine-id
+        # under it, where limine-entry-tool and limine-snapper-sync look for
+        # it (above it, they only find the entry by the PRETTY_NAME of
+        # os-release)
         machine_id = get_machine_id(installation_root_path)
-        config_file.write(f"comment: machine-id={machine_id}\n")
-        config_file.write(f"/+CachyOS\n")
+        branding = libcalamares.globalstorage.value("branding")
+        config_file.write(f"/+{branding['bootloaderEntryName']}\n")
+        config_file.write(f"  comment: machine-id={machine_id}\n")
 
     with open(limine_entry_config_path, 'w') as limine_entry_config:
         limine_entry_config.write(f'ESP_PATH="{efi_directory}"\n')
@@ -1095,9 +1100,12 @@ def prepare_bootloader(fw_type, install_hybrid_grub):
         if libcalamares.globalstorage.contains(gs_name):
             efi_boot_loader = libcalamares.globalstorage.value(gs_name)
         else:
-            libcalamares.utils.warning(
-                f"Specified global storage value not found in global storage")
-            return None
+            # Offline installation: no bootloader chooser page, use efiBootLoader
+            efi_boot_loader = libcalamares.job.configuration.get("efiBootLoader")
+            if efi_boot_loader is None:
+                libcalamares.utils.warning(
+                    f"Specified global storage value not found in global storage")
+                return None
     except KeyError:
         # If the conf value for using global storage is not set, use the setting from the config file.
         try:
diff --git a/src/modules/chwd/main.py b/src/modules/chwd/main.py
index c2d586f..b472405 100755
--- a/src/modules/chwd/main.py
+++ b/src/modules/chwd/main.py
@@ -31,7 +31,7 @@ class HostError(Exception):
 
 
 def pretty_name():
-    return _("Installing needed drivers for CachyOS...")
+    return _("Installing needed drivers...")
 
 
 def line_cb(line):
diff --git a/src/modules/grubcfg/main.py b/src/modules/grubcfg/main.py
index c16a650..9837631 100644
--- a/src/modules/grubcfg/main.py
+++ b/src/modules/grubcfg/main.py
@@ -309,6 +309,9 @@ def run():
     root_mount_point = libcalamares.globalstorage.value("rootMountPoint")
     branding = libcalamares.globalstorage.value("branding")
     bootloader = libcalamares.globalstorage.value("packagechooser_bootloader")
+    if bootloader is None:
+        # Offline installation: no bootloader chooser page, GRUB is installed
+        bootloader = "grub"
 
     if bootloader != "grub":
         libcalamares.utils.warning("User selected bootloader is not GRUB, skipping")
diff --git a/src/modules/netinstall/PackageModel.cpp b/src/modules/netinstall/PackageModel.cpp
index bd666f3..9ae69fb 100644
--- a/src/modules/netinstall/PackageModel.cpp
+++ b/src/modules/netinstall/PackageModel.cpp
@@ -320,6 +320,12 @@ PackageModel::updateSelections( const QStringList& selectNames, const QStringLis
     {
         ::updateSelections( selectNames, unselectNames, m_rootItem );
     }
+    // Hidden groups are not in the tree: select them by name too
+    // (packagechooser netinstall-select, e.g. the desktop of the live ISO)
+    for ( auto* item : m_hiddenItems )
+    {
+        ::updateSelections( selectNames, unselectNames, item );
+    }
 }
 
 PackageTreeItem::List
diff --git a/src/modules/pacstrap/main.py b/src/modules/pacstrap/main.py
index e97005c..f78cbfb 100755
--- a/src/modules/pacstrap/main.py
+++ b/src/modules/pacstrap/main.py
@@ -94,8 +94,7 @@ def run():
     if libcalamares.utils.get_target_platform() == "handheld":
         base_packages += ["linux-cachyos-deckify", "linux-cachyos-deckify-headers"]
     else:
-        base_packages += ["linux-cachyos", "linux-cachyos-headers",
-                         "linux-cachyos-lts", "linux-cachyos-lts-headers"]
+        base_packages += ["linux-cachyos", "linux-cachyos-headers"]
 
 
     bootloader = libcalamares.globalstorage.value("packagechooser_bootloader")
@@ -139,7 +138,7 @@ def run():
         if libcalamares.utils.get_target_platform() == "handheld":
             base_packages += ["linux-cachyos-deckify-zfs"]
         else:
-            base_packages += ["linux-cachyos-zfs", "linux-cachyos-lts-zfs"]
+            base_packages += ["linux-cachyos-zfs"]
     elif is_root_on_btrfs:
         libcalamares.utils.debug("Root on BTRFS")
         if bootloader == "limine":
diff --git a/src/scripts/shell-setup b/src/scripts/shell-setup
index 3708d7c..e051a7f 100755
--- a/src/scripts/shell-setup
+++ b/src/scripts/shell-setup
@@ -1,6 +1,7 @@
 #!/usr/bin/env bash
+# zsh first, as on the live ISO
 user="$1"
-for shell in 'fish' 'zsh'; do
+for shell in 'zsh' 'fish'; do
     if [ -e "/bin/$shell" ]; then
         chsh -s "/bin/${shell}" "$user" && break
     fi
