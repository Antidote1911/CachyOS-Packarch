diff --git a/src/modules/bootloader/main.py b/src/modules/bootloader/main.py
index 4e9095d64..1c315327a 100644
--- a/src/modules/bootloader/main.py
+++ b/src/modules/bootloader/main.py
@@ -1095,9 +1095,12 @@ def prepare_bootloader(fw_type, install_hybrid_grub):
         if libcalamares.globalstorage.contains(gs_name):
             efi_boot_loader = libcalamares.globalstorage.value(gs_name)
         else:
-            libcalamares.utils.warning(
-                f"Specified global storage value not found in global storage")
-            return None
+            # Offline installation: no bootloader chooser page, use efiBootLoader
+            efi_boot_loader = libcalamares.job.configuration.get("efiBootLoader")
+            if efi_boot_loader is None:
+                libcalamares.utils.warning(
+                    f"Specified global storage value not found in global storage")
+                return None
     except KeyError:
         # If the conf value for using global storage is not set, use the setting from the config file.
         try:
diff --git a/src/modules/grubcfg/main.py b/src/modules/grubcfg/main.py
index c16a650df..9837631a1 100644
--- a/src/modules/grubcfg/main.py
+++ b/src/modules/grubcfg/main.py
@@ -309,6 +309,9 @@ def run():
     root_mount_point = libcalamares.globalstorage.value("rootMountPoint")
     branding = libcalamares.globalstorage.value("branding")
     bootloader = libcalamares.globalstorage.value("packagechooser_bootloader")
+    if bootloader is None:
+        # Offline installation: no bootloader chooser page, GRUB is installed
+        bootloader = "grub"
 
     if bootloader != "grub":
         libcalamares.utils.warning("User selected bootloader is not GRUB, skipping")
diff --git a/src/modules/netinstall/PackageModel.cpp b/src/modules/netinstall/PackageModel.cpp
index bd666f3b7..9ae69fbb4 100644
--- a/src/modules/netinstall/PackageModel.cpp
+++ b/src/modules/netinstall/PackageModel.cpp
@@ -320,6 +320,12 @@ PackageModel::updateSelections( const QStringList& selectNames, const QStringLis
     {
         ::updateSelections( selectNames, unselectNames, m_rootItem );
     }
+    // Hidden groups are not in the tree: select them by name too
+    // (packagechooser netinstall-select, e.g. the desktop of the live ISO)
+    for ( auto* item : m_hiddenItems )
+    {
+        ::updateSelections( selectNames, unselectNames, item );
+    }
 }
 
 PackageTreeItem::List
