+# SPDX-FileCopyrightText: no
+# SPDX-License-Identifier: CC0-1.0
+#
+# Online installation of the XFCE live ISO: once the packages are installed,
+# copy the settings of the live ISO to the target (shells, Geany, SMPlayer,
+# LightDM, pacman hooks; the desktop settings come from packarch-xfce-settings
+# or packarch-openbox), set the session of the chosen desktop (XFCE or Openbox),
+# install the stable Rust toolchain for the user when rustup is selected, and
+# remove the local repository of the ISO from the target (attached by
+# shellprocess@before-online). The scripts are shipped by the ISO (airootfs).
+---
+i18n:
+    name: "Copying the settings of the live system"
+    name[fr]: "Copie des réglages du système live"
+dontChroot: true
+timeout: 1800
+script:
+    - command: "/usr/local/bin/apply-live-config ${ROOT} ${USER}"
+      verbose: true
