diff --git a/src/modules/shellprocess/shellprocess_cleanup_live.conf b/src/modules/shellprocess/shellprocess_cleanup_live.conf
new file mode 100644
index 000000000..87558aa93
--- /dev/null
+++ b/src/modules/shellprocess/shellprocess_cleanup_live.conf
@@ -0,0 +1,15 @@
+# SPDX-FileCopyrightText: no
+# SPDX-License-Identifier: CC0-1.0
+#
+# Offline installation (copy of the live system): remove the settings that
+# only make sense on the live ISO, before the initramfs and the bootloader
+# are generated. The script is shipped by the ISO (airootfs).
+---
+i18n:
+    name: "Removing live environment settings"
+    name[fr]: "Suppression des réglages de l'environnement live"
+dontChroot: false
+timeout: 600
+script:
+    - command: "/usr/local/bin/cleanup-live-iso"
+    - "-rm /usr/local/bin/cleanup-live-iso"
